 <odoo>
    <!-- LIST VIEW : estate.property.offer -->
    <record id="view_estate_property_offer_list" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Offers">
                <field name="price"/>
                <field name="partner_id"/>
                <field name="status"/>
                <field name="validity"/>
                <field name="date_deadline"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW : estate.property.offer -->
    <record id="view_estate_property_offer_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Offer">
                <header>
                    <button name="action_accept"
                            type="object"
                            string="Accept"
                            class="btn-primary"/>
                    <button name="action_refuse"
                            type="object"
                            string="Refuse"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <field name="price"/>
                        <field name="partner_id"/>
                        <field name="status"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                        <field name="property_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>