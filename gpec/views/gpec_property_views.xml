<odoo>
    <!-- LIST VIEW -->
    <record id="view_estate_property_list" model="ir.ui.view">
        <field name="name">gpec.property.list</field>
        <field name="model">gpec.property</field>
        <field name="arch" type="xml">
            <list string="GPEC"
                  default_order="date_entree desc"
                  decoration-danger="date_sortie and date_sortie &lt; context_today()">
                <field name="nom_salarie" string="Nom du salarié" class="col-nom"/>
                <field name="prenom_salarie" string="Prénom" class="col-prenom"/>
                <field name="date_entree" widget="date" string="Entrée" class="col-date"/>
                <field name="date_sortie" widget="date" string="Sortie" class="col-date"/>
                <field name="rappel_recrutement" string="Note" class="col-note"/>
                <field name="state" string="Statut"/>

            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_gpec_property_form" model="ir.ui.view">
        <field name="name">gpec.property.form</field>
        <field name="model">gpec.property</field>
        <field name="arch" type="xml">
            <form string="Fiche GPEC salarié">
            <header>
                 <button name="action_next_state"
                         type="object"
                         string="Étape suivante"
                         class="btn-primary"/>

                <field name="state"
                           widget="statusbar"
                           statusbar_visible="en_cours,employe,en_retraite,licencie"/>
            </header>
                <sheet>
                    <group>
                        <field name="nom_salarie"/>
                        <field name="prenom_salarie"/>
                    </group>
                    <notebook>
                        <page string="Données salarié">
                            <group>
                                <field name="date_entree"/>
                                <field name="date_sortie"/>
                                <field name="date_retraite"/>
                                <field name="rappel_recrutement"/>
                                <field name="description"/>
                                <field name="description_poste"/>
                                <field name="type_contrat"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- searchbar -->
 <record id="view_gpec_property_search" model="ir.ui.view">
    <field name="name">gpec.property.search</field>
    <field name="model">gpec.property</field>
    <field name="arch" type="xml">
        <search>
            <!-- Champs recherchables -->
            <field name="nom_salarie" string="Nom du salarié" />
            <field name="prenom_salarie" string="Prénom"/>
            <field name="date_entree"/>
            <field name="date_sortie"/>
            <field name="date_retraite"/>
            <field name="rappel_recrutement"/>

            <!-- Filtres -->
            <filter name="filter_current"
                    string="En poste"
                    domain="[('date_sortie','=',False)]"/>
            <filter name="filter_left"
                    string="Sortis"
                    domain="[('date_sortie','!=',False)]"/>

        
        </search>
    </field>
</record>


    
    <record id="action_gpec_property" model="ir.actions.act_window">
        <field name="name">GPEC</field>
        <field name="res_model">gpec.property</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gpec_property_search"/>
    </record>

    <!-- Boutons de la navbar -->
    <menuitem id="menu_gpec_root"
              name="GPEC"
              sequence="10"/>

    <menuitem id="menu_gpec_property"
              name="GPEC"
              parent="menu_gpec_root"
              action="action_gpec_property"
              sequence="10"/>
</odoo>
